# Spans and expected diagnostics count bytes and columns: keep programs and expectations in LF on every OS.
*.atls text eol=lf
*.stderr text eol=lf
*.json text eol=lf
# The runtime headers are compiled into atlc and written out as they are, the same bytes on every OS; expected C++ is
# compared byte for byte.
runtime/include/** text eol=lf
tests/codegen/*.hpp text eol=lf
