# Corners of the grammar that the other programs do not reach; it parses, whatever the checker says.
replay { replay.on_bar = -1.5; if.else = "x"; window = true; fill = false; target.state.in = 2; }
params {
  int<lower=1, lower=2, upper=3> n = (20);
  real<upper=-(1 + 2) * 3> lower = -.5e-3;
  bool upper = true;
}
options { missing = skip; min = n + 1; }
instruments { window; value; }
warmup n * (n - 1);
functions {
  real none() { return 1; }
  bool many(int a, real b, bool c) { if (c) { return a < b; } else if (not c) { return false; } else { return true; } }
}
indicator ind(real x, int n) {
  window w[n * 2];
  state real s = 0;
  warmup n + 1;
  update { for (i in 1:n) { s = s + i; } }
  enter() { }
  leave(a, b) { s = s - a; }
  value real v = w.count;
  value real enter = s;
}
series {
  real a = ind(close, 3).v[1][2];
  real b = f(missing = skip, min = 2, close);
  real c = -x[1] - - y ? 1 : z ? 2 : 3;
  bool d = not not (a <= b) and (c != 1 or c == 2) and a >= b;
  real e = window.close + update(leave, enter);
}
on_bar {
  target(window, value + 1);
  target(- 1);
  if (a > b) { } else { if (c) { target(0); } }
}
