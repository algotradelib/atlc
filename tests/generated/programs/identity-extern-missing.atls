// A universe whose instruments miss bars: ma and roll_ols beside external indicators that restate them
// (tests/generated/user-code.hpp), under `missing = restart`, where each instrument runs on its own bars, and in a
// copy under `missing = poison`, where a missing bar is an undefined input (the test also builds a copy per mode). roll_ols always restarts, so its external states `restart`. One fill of one share per
// instrument means equal values (atls `==`) and the same definedness on every bar after the gate.
universe {}
options { missing = restart; }
params {
  int<lower=2> n = 20;
}

extern indicator inc_sma(real x, int n) {
  warmup n;
  value real mean;
}

extern indicator inc_ols(real y, real x, int n) {
  warmup n;
  value real slope;
  value real intercept;
}

series {
  real ret = close / close[1] - 1;
  real a1 = ma(close, n);
  real b1 = inc_sma(close, n);
  real a2 = roll_ols(ret, close, n).slope;
  real b2 = inc_ols(ret, close, n, missing = restart).slope;
  real a3 = roll_ols(ret, close, n).intercept;
  real b3 = inc_ols(ret, close, n, missing = restart).intercept;
}
state {
  int diffs = 0;
}
on_bar {
  bool d1 = defined(a1) and defined(b1) ? a1 == b1 : defined(a1) == defined(b1);
  bool d2 = defined(a2) and defined(b2) ? a2 == b2 : defined(a2) == defined(b2);
  bool d3 = defined(a3) and defined(b3) ? a3 == b3 : defined(a3) == defined(b3);
  if (not (d1 and d2 and d3)) {
    diffs = diffs + 1;
  }
  target(1 + diffs);
}
