// A partial sum over a lag, under a skip window: decided from the gate (k + 1), whole from k + h + m - 2.
params {
  int<lower=1> k = 5;
  int<lower=2> h = 10;
  int<lower=1> m = 3;
}
series {
  real u = sma(ts_sum(sign(close - close[k]), h - 1, 1), m, missing = skip);
}
on_bar {
  if (defined(u)) {
    target(100 + 10 * u);
  }
}
