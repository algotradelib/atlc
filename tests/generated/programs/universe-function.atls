# Cross-sectional values passed to a function: each instrument targets a hundredth of the mean close (the sum over
# the count is the same number).
universe {}
functions {
  real id(real x) {
    return x;
  }
}
on_bar {
  real x = id(xs_mean(close));
  real y = id(xs_sum(close)) / xs_count(close);
  target(min(x, y) / 100);
}
