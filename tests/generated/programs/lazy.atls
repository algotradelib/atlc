# Only the arm a condition selects is evaluated, and the right side of `and` or `or` only when the left does not
# decide: an unused n * n that does not fit in 64 bits stops nothing. `which` picks the expression.
params {
  int n = 100000000000000;
  int which = 0;
}
on_bar {
  if (which == 0) {
    target(open != 1 ? n * n : keep);
  } else if (which == 1) {
    if (open > 1 and n * n > 0) {
      target(1);
    }
  } else {
    if (open <= 1 or n * n > 0) {
      target(2);
    }
  }
}
