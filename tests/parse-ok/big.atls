state {
  int count = 0;
  real last = 0.5;
  bool armed = true;
}
on_start {
  count = 0;
}
on_bar {
  real x = -a + - -b * 3;
  int k = held != 0 ? 1 : held == 0 ? 2 : 3;
  for (i in 1:fast + 1) {
    count = count + i;
  }
  if (up and not armed) {
    target(quantity());
  } else if (close <= b or (a > b and close > a)) {
    target(0);
  } else if (not not armed) {
    armed = false;
  } else {
    log(x, k, -1);
  }
  if (x > 0) {
    noop();
