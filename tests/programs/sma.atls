# The library's SmaCrossover: long while the fast average is above the slow one.
params {
  int<lower=1> fast = 20;
  int<lower=fast + 1> slow = 50;
  int<lower=0> quantity = 100;
}
warmup slow + 1;
series {
  real fast_avg = sma(close, fast);
  real slow_avg = sma(close, slow);
}
on_bar {
  target(fast_avg > slow_avg ? quantity : 0);
}
