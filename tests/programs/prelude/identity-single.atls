# Identity check: each built-in beside its user-indicator copy (prelude.atls). The program counts the
# bars where a value or its definedness differs and states that count as its target, so a run with
# no fills means identical bits on every bar after the warm-up.
params {
  int<lower=2> n = 20;
}

# sma(x, n): a running sum over the window.
indicator u_sma(real x, int n) {
  window w[n];
  state real s = 0;
  enter(v) { s = s + v; }
  leave(v) { s = s - v; }
  value real mean = s / n;
}

# stdev(x, n) and zscore(x, n): running sums of the values and their squares, sample deviation.
indicator u_dev(real x, int n) {
  window w[n];
  state real s = 0;
  state real q = 0;
  enter(v) {
    s = s + v;
    q = q + v * v;
  }
  leave(v) {
    s = s - v;
    q = q - v * v;
  }
  value real sd = sqrt((q - s * s / n) / (n - 1));
  value real z = sd > 0 ? (x - s / n) / sd : keep;
}

# ols_slope(y, x, n) and ols_intercept(y, x, n): least squares with an intercept from running sums.
indicator u_ols(real y, real x, int n) {
  window w[n];
  state real sx = 0;
  state real sy = 0;
  state real sxx = 0;
  state real sxy = 0;
  enter(a, b) {
    sx = sx + b;
    sy = sy + a;
    sxx = sxx + b * b;
    sxy = sxy + b * a;
  }
  leave(a, b) {
    sx = sx - b;
    sy = sy - a;
    sxx = sxx - b * b;
    sxy = sxy - b * a;
  }
  value real d = n * sxx - sx * sx;
  value real slope = d != 0 ? (n * sxy - sx * sy) / d : keep;
  value real intercept = (sy - slope * sx) / n;
}

# ema(x, n): seeded with the mean of the first n values, then alpha = 2 / (n + 1); no window.
indicator u_ema(real x, int n) {
  state int seen = 0;
  state real sum = 0;
  state real e = 0;
  update {
    seen = seen + 1;
    if (seen <= n) {
      sum = sum + x;
      if (seen == n) {
        e = sum / n;
      }
    } else {
      e = 2.0 / (n + 1.0) * x + (1 - 2.0 / (n + 1.0)) * e;
    }
  }
  warmup n;
  value real ema = e;
}

series {
  real a1 = sma(close, n);
  real b1 = u_sma(close, n);
  real a2 = stdev(close, n);
  real b2 = u_dev(close, n).sd;
  real a3 = zscore(close, n);
  real b3 = u_dev(close, n).z;
  real a4 = ema(close, n);
  real b4 = u_ema(close, n);
}
state {
  int diffs = 0;
}
on_bar {
  bool d1 = defined(a1) and defined(b1) ? a1 == b1 : defined(a1) == defined(b1);
  bool d2 = defined(a2) and defined(b2) ? a2 == b2 : defined(a2) == defined(b2);
  bool d3 = defined(a3) and defined(b3) ? a3 == b3 : defined(a3) == defined(b3);
  bool d4 = defined(a4) and defined(b4) ? a4 == b4 : defined(a4) == defined(b4);
  if (not (d1 and d2 and d3 and d4)) {
    diffs = diffs + 1;
  }
  target(diffs);
}
