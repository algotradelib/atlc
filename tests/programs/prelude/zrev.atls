# A z-score reversion with an EMA trend filter, built-in indicators: buy below -2 deviations while
# above the EMA, out above 0.
params {
  int<lower=2> n = 60;
  int<lower=1> trend = 200;
  int<lower=0> quantity = 500;
}
series {
  real z = zscore(close, n);
  real sd = stdev(close, n);
  real level = ema(close, trend);
}
on_bar {
  if (held == 0 and z < -2 and close > level and sd > 0) {
    target(quantity);
  } else if (held != 0 and z > 0) {
    target(0);
  }
}
