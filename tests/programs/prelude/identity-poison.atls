# Identity check under `missing = poison` over the book's 497 stocks (missing before they list): the
# built-ins beside user indicators written with the window's count. Zero fills: identical bits.
universe {}
options { missing = poison; }
params {
  int<lower=2> n = 20;
}

indicator u_mean(real x, int n) {
  window w[n];
  state real s = 0;
  enter(v) { s = s + v; }
  leave(v) { s = s - v; }
  value real mean = s / w.count;
}

indicator u_pdev(real x, int n) {
  window w[n];
  state real s = 0;
  state real q = 0;
  enter(v) {
    s = s + v;
    q = q + v * v;
  }
  leave(v) {
    s = s - v;
    q = q - v * v;
  }
  value real sd = sqrt(max((q - s * s / w.count) / w.count, 0));
}

series {
  real ret = close / close[1] - 1;
  real a1 = sma(close, n);
  real b1 = u_mean(close, n);
  real a2 = stdev_pop(ret, n);
  real b2 = u_pdev(ret, n);
}
state {
  int diffs = 0;
}
on_close {
  bool d1 = defined(a1) and defined(b1) ? a1 == b1 : defined(a1) == defined(b1);
  bool d2 = defined(a2) and defined(b2) ? a2 == b2 : defined(a2) == defined(b2);
  if (not (d1 and d2)) {
    diffs = diffs + 1;
  }
  target(diffs);
}
