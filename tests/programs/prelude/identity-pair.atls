# Identity check for the least-squares indicators: ols_slope and ols_intercept beside u_ols.
instruments { y; x; }
params {
  int<lower=2> n = 20;
}

# sma(x, n): a running sum over the window.
indicator u_sma(real x, int n) {
  window w[n];
  state real s = 0;
  enter(v) { s = s + v; }
  leave(v) { s = s - v; }
  value real mean = s / n;
}

# stdev(x, n) and zscore(x, n): running sums of the values and their squares, sample deviation.
indicator u_dev(real x, int n) {
  window w[n];
  state real s = 0;
  state real q = 0;
  enter(v) {
    s = s + v;
    q = q + v * v;
  }
  leave(v) {
    s = s - v;
    q = q - v * v;
  }
  value real sd = sqrt((q - s * s / n) / (n - 1));
  value real z = sd > 0 ? (x - s / n) / sd : keep;
}

# ols_slope(y, x, n) and ols_intercept(y, x, n): least squares with an intercept from running sums.
indicator u_ols(real y, real x, int n) {
  window w[n];
  state real sx = 0;
  state real sy = 0;
  state real sxx = 0;
  state real sxy = 0;
  enter(a, b) {
    sx = sx + b;
    sy = sy + a;
    sxx = sxx + b * b;
    sxy = sxy + b * a;
  }
  leave(a, b) {
    sx = sx - b;
    sy = sy - a;
    sxx = sxx - b * b;
    sxy = sxy - b * a;
  }
  value real d = n * sxx - sx * sx;
  value real slope = d != 0 ? (n * sxy - sx * sy) / d : keep;
  value real intercept = (sy - slope * sx) / n;
}

# ema(x, n): seeded with the mean of the first n values, then alpha = 2 / (n + 1); no window.
indicator u_ema(real x, int n) {
  state int seen = 0;
  state real sum = 0;
  state real e = 0;
  update {
    seen = seen + 1;
    if (seen <= n) {
      sum = sum + x;
      if (seen == n) {
        e = sum / n;
      }
    } else {
      e = 2.0 / (n + 1.0) * x + (1 - 2.0 / (n + 1.0)) * e;
    }
  }
  warmup n;
  value real ema = e;
}

series {
  real a1 = ols_slope(y.close, x.close, n);
  real b1 = u_ols(y.close, x.close, n).slope;
  real a2 = ols_intercept(y.close, x.close, n);
  real b2 = u_ols(y.close, x.close, n).intercept;
}
state {
  int diffs = 0;
}
on_bar {
  bool d1 = defined(a1) and defined(b1) ? a1 == b1 : defined(a1) == defined(b1);
  bool d2 = defined(a2) and defined(b2) ? a2 == b2 : defined(a2) == defined(b2);
  if (not (d1 and d2)) {
    diffs = diffs + 1;
  }
  target(y, diffs);
}
