# Built-in indicators written as user indicators: the same arithmetic in the same order, so they give
# the built-ins' bits (sma, stdev, zscore, ols_slope/ols_intercept, ema), and a function.
# `atlc` has no include yet: the test programs beside this file carry a copy of what they use.

functions {
  # A value held within [-cap, cap].
  real clip(real z, real cap) {
    if (z > cap) {
      return cap;
    }
    return max(z, -cap);
  }
}

# sma(x, n): a running sum over the window.
indicator u_sma(real x, int n) {
  window w[n];
  state real s = 0;
  enter(v) { s = s + v; }
  leave(v) { s = s - v; }
  value real mean = s / n;
}

# stdev(x, n) and zscore(x, n): running sums of the values and their squares, sample deviation.
indicator u_dev(real x, int n) {
  window w[n];
  state real s = 0;
  state real q = 0;
  enter(v) {
    s = s + v;
    q = q + v * v;
  }
  leave(v) {
    s = s - v;
    q = q - v * v;
  }
  value real sd = sqrt((q - s * s / n) / (n - 1));
  value real z = sd > 0 ? (x - s / n) / sd : keep;
}

# ols_slope(y, x, n) and ols_intercept(y, x, n): least squares with an intercept from running sums.
indicator u_ols(real y, real x, int n) {
  window w[n];
  state real sx = 0;
  state real sy = 0;
  state real sxx = 0;
  state real sxy = 0;
  enter(a, b) {
    sx = sx + b;
    sy = sy + a;
    sxx = sxx + b * b;
    sxy = sxy + b * a;
  }
  leave(a, b) {
    sx = sx - b;
    sy = sy - a;
    sxx = sxx - b * b;
    sxy = sxy - b * a;
  }
  value real d = n * sxx - sx * sx;
  value real slope = d != 0 ? (n * sxy - sx * sy) / d : keep;
  value real intercept = (sy - slope * sx) / n;
}

# ema(x, n): seeded with the mean of the first n values, then alpha = 2 / (n + 1); no window.
indicator u_ema(real x, int n) {
  state int seen = 0;
  state real sum = 0;
  state real e = 0;
  update {
    seen = seen + 1;
    if (seen <= n) {
      sum = sum + x;
      if (seen == n) {
        e = sum / n;
      }
    } else {
      e = 2.0 / (n + 1.0) * x + (1 - 2.0 / (n + 1.0)) * e;
    }
  }
  warmup n;
  value real ema = e;
}

series {
  real level = clip(close - u_sma(close, 20), 5);
}
on_bar {
  target(level > 0 ? 100 : 0);
}
