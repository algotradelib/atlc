# Cross-sectional linear long-short (Chan 2013, Example 4.3): each day, weight every stock by
# minus its return less the day's mean return, normalized to one dollar gross, `scale` dollars.
universe {}
params {
  real<lower=0> scale = 100000;
}
series {
  real ret = close / close[1] - 1;
}
on_bar {
  real d = -(ret - xs_mean(ret));
  real w = d / xs_sum(abs(d));
  target(round(w / close * scale));
}
