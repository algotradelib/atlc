# Example 3.1 on log prices: the hedge and the spread are fitted to logs, and a unit is
# `scale` dollars of each leg.
instruments {
  y;
  x;
}
params {
  int<lower=2> lookback = 20;
  real<lower=0> scale = 10000000;
}
series {
  real ly = log(y.close);
  real lx = log(x.close);
  real hedge = ols_slope(ly, lx, lookback);
  real spread = ly - hedge * lx;
  real units = -zscore(spread, lookback);
}
on_bar {
  target(y, round(units * scale / y.close));
  target(x, round(-hedge * units * scale / x.close));
}
