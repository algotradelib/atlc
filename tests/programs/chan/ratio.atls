# Example 3.1 on the price ratio y / x: no hedge to fit; a unit is `scale` dollars of each leg.
instruments {
  y;
  x;
}
params {
  int<lower=2> lookback = 20;
  real<lower=0> scale = 10000000;
}
series {
  real units = -zscore(y.close / x.close, lookback);
}
on_bar {
  target(y, round(units * scale / y.close));
  target(x, round(-units * scale / x.close));
}
