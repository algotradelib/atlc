# Bollinger bands on a pair (Chan 2013, Example 3.2): the spread of y over its rolling hedge
# on x; enter beyond `entry` deviations, leave when the z-score crosses `exit`.
instruments {
  y;
  x;
}
params {
  int<lower=2> lookback = 20;
  real entry = 1;
  real<upper=entry> exit = 0;
  int<lower=0> scale = 1000;
}
series {
  real hedge = ols_slope(y.close, x.close, lookback);
  real spread = y.close - hedge * x.close;
  real z = zscore(spread, lookback);
}
state {
  bool long = false;
  bool short = false;
}
# The reference starts one bar after the z-score is first defined.
warmup 2 * lookback;
on_bar {
  if (defined(z)) {
    if (z < -entry) {
      long = true;
    } else if (z > -exit) {
      long = false;
    }
    if (z > entry) {
      short = true;
    } else if (z < exit) {
      short = false;
    }
  }
  real units = (long ? 1 : 0) - (short ? 1 : 0);
  target(y, units * scale);
  target(x, round(-hedge * units * scale));
}
